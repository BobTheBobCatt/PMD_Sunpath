"ice_fang": {
"$type": "RogueEssence.Data.SkillDataSummary, RogueEssence",
"Element": "ice",
"Category": 1,
"BasePower": 65,
"BaseCharges": 18,
"HitRate": 100,
"RangeDescription": "Foe in Front",
"Description": {
"DefaultText": "The user bites with cold-infused fangs. This may also make the target flinch or leave it frostbitten.",
"LocalTexts": {
"fr": "Le lanceur utilise une morsure glaciale. Peut aussi geler ou apeurer l’ennemi.",
"de": "Anwender beißt mit eiskalten Reißzähnen zu. Ziel schreckt eventuell zurück oder friert ein.",
"es": "Usa colmillos helados para morder. Puede hacer que el objetivo retroceda o se congele.",
"it": "Chi la usa morde con denti ghiacciati. Può anche congelare o far tentennare il bersaglio.",
"ko": "냉기를 품은 이빨로 문다. 상대를 풀죽게 하거나 얼음 상태로 만들 때가 있다.",
"ja": "れいきを　ひめた　キバで　か つく。 あいてを　ひるませたり こおり　じょうたいに　することが　ある。",
"ja-jp": "冷気を　ひめた　キバで　か つく。 相手を　ひるませたり こおり状態に　することが　ある。",
"zh-hans": "用藏有冷气的牙齿咬住对手。有时会使对手畏缩或陷入冰冻状态。",
"zh-hant": "用帶有寒氣的牙齒咬住對手。 有時會讓對手畏縮 或陷入冰凍狀態。"
}
},
"Name": {
"DefaultText": "Ice Fang",
"LocalTexts": {
"fr": "Crocs Givre",
"de": "Eiszahn",
"es": "Colmillo Hielo",
"it": "Gelodenti",
"ko": "얼음엄니",
"ja": "こおりのキバ",
"ja-jp": "こおりのキバ",
"zh-hans": "冰冻牙",
"zh-hant": "冰凍牙"
}
},
"Released": true,
"Comment": "",
"SortOrder": 423
},
"ice_punch": {
"$type": "RogueEssence.Data.SkillDataSummary, RogueEssence",
"Element": "ice",
"Category": 1,
"BasePower": 75,
"BaseCharges": 18,
"HitRate": 100,
"RangeDescription": "Foe in Front",
"Description": {
"DefaultText": "The target is punched with an icy fist. This may also leave the target frostbitten.",
"LocalTexts": {
"fr": "Un coup de poing glacé vient frapper l’ennemi. Peut le geler.",
"de": "Ein eisiger Schlag, der das Ziel eventuell einfriert.",
"es": "Puñetazo helado. Puede congelar.",
"pt": "O alvo é socado com um punho congelante. Possui chance de congelar o alvo.",
"it": "Il Pokémon attacca il bersaglio con un pugno di ghiaccio che può congelarlo.",
"ko": "냉기를 담은 펀치로 상대를 공격한다. 얼음 상태로 만들 때가 있다.",
"ja": "れいきを　こめた　パンチで あいてを　こうげきする。 こおり　じょうたいに　することが　ある。",
"ja-jp": "冷気を　こめた　パンチで 相手を　攻撃する。 こおり状態に　することが　ある。",
"zh-hans": "用充满寒气的拳头攻击对手。有时会让对手陷入冰冻状态。",
"zh-hant": "用帶有寒氣的拳頭 攻擊對手。 有時會讓對手陷入冰凍狀態。"
}
},
"Name": {
"DefaultText": "Ice Punch",
"LocalTexts": {
"fr": "Poing-Glace",
"de": "Eishieb",
"es": "Puño Hielo",
"pt": "Soco de Gelo",
"it": "Gelopugno",
"ko": "냉동펀치",
"ja": "れいとうパンチ",
"ja-jp": "れいとうパンチ",
"zh-hans": "冰冻拳",
"zh-hant": "冰凍拳"
}
},
"Released": true,
"Comment": "",
"SortOrder": 8
},
"lovely_kiss": {
"$type": "RogueEssence.Data.SkillDataSummary, RogueEssence",
"Element": "normal",
"Category": 3,
"BasePower": -1,
"BaseCharges": 16,
"HitRate": 100,
"RangeDescription": "Foes in 2-Tile Cone",
"Description": {
"DefaultText": "With a scary face, the user tries to force a kiss on the target. If it succeeds, the target becomes drowsy.",
"LocalTexts": {
"fr": "Le lanceur fait un bisou à l’ennemi en prenant une mine effrayante. Endort l’ennemi.",
"de": "Anwender zwingt dem Ziel einen Kuss auf, der Schlaf verursacht.",
"es": "Con una cara que asusta, da un beso al objetivo y lo adormece.",
"it": "Il Pokémon intimidisce il bersaglio con una faccia paurosa e gli schiocca un bacio che lo fa addormentare.",
"ko": "무서운 얼굴로 키스를 시도한다. 성공하면 상대를 잠듦 상태로 만든다.",
"ja": "おそろしい　かおで　キスを　せまる。 あいてを　ねむり　じょうたいに　する。",
